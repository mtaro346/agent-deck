{
  "name": "agent-deck-streamdeck",
  "version": "0.1.0",
  "description": "Elgato Stream Deck plugin for agent-deck. Supports Stream Deck +, XL, and all key-based models.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "gen:icons": "node tools/gen-icons.mjs",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "validate": "streamdeck validate com.mtaro346.agent-deck.sdPlugin",
    "link": "streamdeck link com.mtaro346.agent-deck.sdPlugin",
    "restart": "streamdeck restart com.mtaro346.agent-deck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elgato/streamdeck": "^1.0.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.0.0",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/node": "^20.16.0",
    "rollup": "^4.24.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
